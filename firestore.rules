// PROWORLD — database security rules for the whole site: the Dashboard, Marketing and the Coach Portal.
// Published with the site from Cloud Shell (firebase deploy --only firestore:rules,hosting), or paste this whole file
// into Firebase console → Firestore Database → Rules → Publish.
//
// What it guarantees, whatever a web page does or whoever finds its address:
//   • Nobody reads or writes anything without signing in with a CONFIRMED Google account.
//   • Signing in is not enough: the email must be on the staff list with access switched on (or be an owner below),
//     and each part of the site needs its page ticked for that person on the Dashboard (staff/<email>.pages):
//       Marketing        → "mkt"
//       Coach Portal     → "coach-portal"   (players, assessments, videos, journal, goals)
//       Try-outs         → "tryouts" or "coach-portal"
//       Backend          → "backend"  (players, attendance lists, the shared record, the engine's ledger)
//       Every other page → its own id (a copied page's key in pageKeys/<id>, an outside page's link in pageLinks/<id>)
//     People added before the Dashboard had sign-in carry no `pages` list: they keep exactly what they had —
//     the Coach Portal and Try-outs.
//   • Owners (by account id, below) see and unlock everything. Administrators manage other people but can only hand out
//     pages they hold themselves, and never touch an owner or their own entry. Deleting players, assessments, try-outs
//     or groups needs an administrator who also has the Coach Portal.
//   • The scheduled runs sign in as ONE dedicated account (made by the owner in Authentication → Users). It can read and
//     write the marketing record and, for the morning Monday sync, read the players and write only Monday's fields on them,
//     the parent details, the Coach Board and the change log. It cannot read assessments or delete anything.
//   • A person who is not staff can do exactly one thing: leave a request, under their own id, containing only their
//     own email, a name and a time.
//   • Anything not listed here is refused.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function okProvider() {
      return request.auth.token.firebase.sign_in_provider in ['google.com'];
    }
    function verified() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && okProvider();
    }
    // The staff list is keyed by the lower-case email address.
    function me() { return request.auth.token.email.lower(); }

    // Owners: always everything, even before any staff list exists, and the only ones who can unlock any page for anyone.
    // Listed by User UID (Authentication → Users): PDKJkouns6g6zA1jrABJijEr3oq2 = the operations account (Antonio),
    // OLWbZu29WVUWUbN8W9HdPpOZgmj2 = Lorenzo. Changing this list means deploying these rules — nothing on a page can.
    function owner() { return verified() && request.auth.uid in ['PDKJkouns6g6zA1jrABJijEr3oq2', 'OLWbZu29WVUWUbN8W9HdPpOZgmj2']; }

    function staffRec() { return get(/databases/$(database)/documents/staff/$(me())).data; }
    function onStaff() {
      return verified()
        && exists(/databases/$(database)/documents/staff/$(me()))
        && staffRec().active == true;
    }
    function admin() { return owner() || (onStaff() && staffRec().role == 'admin'); }
    // A tennis director (Antonio, Oct 24): everything inside Coaches — assigns coaches, edits players, Messages, Courts, and
    // manages who has access. An administrator or owner counts as one. Everyone else on the Coach Portal is a coach: their own players.
    function director() { return admin() || (onStaff() && staffRec().role == 'director'); }
    // A page ticked for this person on the Dashboard (or, for an older record with no page list, the Coach Portal and Try-outs).
    function hasPage(p) {
      return owner() || (onStaff() && (('pages' in staffRec()) ? (p in staffRec().pages) : (p in ['coach-portal', 'tryouts'])));
    }
    // The pages this person holds (an older record with no page list: the Coach Portal and Try-outs).
    function myPages() { return ('pages' in staffRec()) ? staffRec().pages : ['coach-portal', 'tryouts']; }
    function portal() { return hasPage('coach-portal'); }
    function tryoutsOk() { return hasPage('coach-portal') || hasPage('tryouts'); }
    // The backend (/backend): front desk, attendance, players & billing. The old be-* ids count as the same page.
    function backend() { return hasPage('backend') || hasPage('be-owner') || hasPage('be-desk') || hasPage('be-coach') || hasPage('be-parent'); }

    // The scheduled runs (Sunday engine, Monday review, morning numbers, morning Monday sync): one email/password account,
    // runs@proworldacademy.com — its User UID from Authentication → Users.
    function runs() { return request.auth != null && request.auth.uid == '6Gg4rULeUnZa7wT6ueO5KLgwvcZ2'; }

    // ── People ──
    // A signed-in person may read their OWN entry (that is how every page knows what to show them);
    // owners and administrators see the whole list. Owners change anyone. An administrator (a director) changes other
    // people only — never their own entry, never an owner, never makes anyone an owner — and hands out only pages they
    // hold themselves, so nobody but an owner can unlock Marketing, Finance or anything else they don't have.
    match /staff/{email} {
      allow get: if director() || (verified() && me() == email);   // Staff & access: directors and owners (Antonio, Oct 24)
      allow list: if director();
      allow create, update: if owner() || (director()
        && email != me()
        && request.resource.data.get('owner', false) != true
        && (resource == null || resource.data.get('owner', false) != true)
        && request.resource.data.get('pages', []).toSet().difference(myPages().toSet()).size() == 0);
      allow delete: if owner() || (director()
        && email != me()
        && resource.data.get('owner', false) != true
        && resource.data.get('pages', []).toSet().difference(myPages().toSet()).size() == 0);
    }
    // "Please let me in" notes from people who signed in but are not on the list yet.
    match /requests/{uid} {
      allow get: if director() || (verified() && request.auth.uid == uid);
      allow list, delete: if director();
      allow create, update: if verified()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'at'])
        && request.resource.data.email == me()
        && request.resource.data.name is string
        && request.resource.data.name.size() < 120;
    }

    // ── Coach Portal ──
    match /groups/{id} {
      allow read: if tryoutsOk();
      allow write: if portal() && director();
    }
    // Players — the one roster. Written by the morning Monday sync (the runs account: Monday's fields only, never deletes),
    // the Coach Portal, the front desk on the backend, and the billing engine (a family that enrolls online: it writes with the
    // admin SDK, outside these rules — see functions/lib/roster.js for exactly what it writes).
    match /players/{id} {
      // (the runs account is checked first everywhere, so its sign-in never has to pass the staff checks)
      allow read: if runs() || portal() || backend();
      allow create: if (runs()
        && request.resource.data.keys().hasOnly(['name', 'shortName', 'group', 'tier', 'coach', 'coach2', 'fitness', 'status', 'source',
                                                 'mondayId', 'monday', 'createdAt', 'updatedAt', 'createdBy'])) || (!runs() && ((portal() && director()) || backend()));
      allow update: if (runs()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'shortName', 'status', 'coach', 'coach2', 'mondayId', 'monday', 'updatedAt']))
        || (!runs() && portal() && director())   // a player's coach, group, tier, status: directors (Oct 24); coaches write assessments, not the record
        || (!runs() && backend() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['group', 'coach', 'coach2', 'status', 'sport', 'updatedAt']));
      allow delete: if portal() && admin();
      // Parent name, email and phone: from Monday (the sync), from the enrollment page (the engine) or typed at the front desk.
      // Opened behind a button on the player's page, never shown in lists.
      match /private/{doc} {
        allow read: if runs() || portal() || backend();
        allow write: if runs() || (backend()
          && request.resource.data.keys().hasOnly(['guardian', 'email', 'phone', 'dob', 'source', 'updatedAt', 'mondayId', 'syncedAt']));
      }
    }
    // Changes made in the portal that Monday must get with the next morning sync: a coach-added player (it goes to the
    // front desk's New Requests on the LEADS board) or a player marked away / finished / active. Anyone with the Coach
    // Portal files one in their own name; only the sync moves it on.
    match /outbox/{id} {
      allow read: if runs() || portal() || backend();
      allow create: if !runs() && (portal() || backend())
        && request.resource.data.keys().hasOnly(['type', 'pid', 'name', 'first', 'last', 'group', 'coach', 'note', 'mondayId', 'from', 'to',
                                                 'by', 'byName', 'at', 'state'])
        && request.resource.data.type in ['add', 'status']
        && request.resource.data.state == 'queued'
        && request.resource.data.by == me()
        && request.resource.data.get('note', '') is string
        && request.resource.data.get('note', '').size() < 1000;
      allow update: if runs()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'result', 'sentAt', 'placedAt', 'doneAt', 'note']);
      allow delete: if !runs() && portal() && admin();
    }
    // The Coach Board (one document) and the change log of every sync: everyone with the Coach Portal reads them.
    match /board/{doc} {
      allow read: if runs() || portal();
      allow write: if runs();
    }
    match /syncLog/{id} {
      allow read: if portal();
      allow create, update: if runs();
    }
    // Sync settings: preview or live. Owners only.
    match /syncCfg/{doc} {
      allow read: if runs() || portal();
      allow write: if !runs() && owner();
    }
    match /assessments/{id} {
      allow read, create, update: if portal();
      allow delete: if portal() && admin();
      match /body/{doc} {
        allow read, create, update: if portal();
        allow delete: if portal() && admin();
      }
    }
    match /tryouts/{id} {
      allow read, create, update: if tryoutsOk() || backend();
      allow delete: if tryoutsOk() && admin();
    }

    // ── The backend (/backend) ──
    // enrollments/<checkout session>: the billing engine's ledger of every paid checkout (what was bought, who was told). Read only.
    match /enrollments/{id} {
      allow read: if backend() || portal();
    }
    // backend/state: what the front desk, attendance and courts share — court blocks, bookings, privates, charges, the "Sent" log,
    // per-player notes. One document, written by whoever holds the backend page.
    match /backend/{doc} {
      allow read: if backend();
      allow write: if !runs() && backend() && request.resource.data.size() < 200;
    }
    // sheets/<date>_<session>: one attendance list per session per day.
    match /sheets/{id} {
      allow read: if backend() || portal();
      allow write: if !runs() && backend() && id.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z0-9]{1,12}');
    }
    // settings/notify: where the engine's messages go (Slack webhooks, the JustCall line). Owners only — the engine reads it
    // with the admin SDK.
    match /settings/{doc} {
      allow read, write: if !runs() && owner();
    }
    // familyRequests: what a parent asked the front desk for from the family portal. The engine files them (admin SDK);
    // the front desk reads them and closes them with a short reply the family sees. Nobody creates or deletes one from here.
    match /familyRequests/{id} {
      allow read: if backend();
      allow update: if !runs() && backend() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'reply', 'repliedAt', 'repliedBy'])
                    && request.resource.data.state in ['open', 'done'];
    }
    // Messages (texts to families from the backend): the engine writes the batches and one line per recipient (admin SDK);
    // staff read them for the Sent history and a player's profile. Consent lives in players/<id>/private/sms, engine-written.
    match /smsBatches/{id} { allow read: if backend() || portal(); }   // Messages: every coach holds it (Antonio, Oct 24)
    match /smsLog/{id}     { allow read: if backend() || portal(); }
    match /smsWebhookLog/{id} { allow read: if backend(); }     // what JustCall's webhook sent and what the engine did with it (no bodies, no full numbers)
    match /videos/{id}  { allow read, write: if portal(); }
    match /journal/{id} { allow read, write: if portal(); }
    match /goals/{id}   { allow read, write: if portal(); }

    // ── Pages copied onto this site (/p?id=<page>): the reports, plans and prototypes that used to open on claude.ai ──
    // Each is a locked file on the public site; its key is here and opens only for someone who holds that page.
    match /pageKeys/{id} {
      allow read: if hasPage(id);
      allow write: if !runs() && owner();
    }
    // ── Pages that live elsewhere (the live attendance and directors pages): the link an owner saved, with its key ──
    match /pageLinks/{id} {
      allow read: if hasPage(id);
      allow write: if !runs() && owner()
        && request.resource.data.keys().hasOnly(['url', 'at', 'by'])
        && request.resource.data.url is string
        && request.resource.data.url.size() < 2000
        && request.resource.data.url.matches('https://[^ ]+');
    }

    // ── The AI & comms check (/checks): the latest result per item, and a log of every tick, in the person's own name ──
    match /checks/{id} {
      allow read: if hasPage('ai-check');
      allow create, update: if !runs() && hasPage('ai-check')
        && id.matches('[a-z0-9-]{1,40}')
        && request.resource.data.keys().hasOnly(['ok', 'note', 'at', 'by', 'who'])
        && request.resource.data.ok is bool
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.who is string && request.resource.data.who.size() <= 80
        && request.resource.data.at is number
        && request.resource.data.by == me();
    }
    match /checkLog/{id} {
      allow read: if hasPage('ai-check');
      allow create: if !runs() && hasPage('ai-check')
        && request.resource.data.keys().hasOnly(['item', 'ok', 'note', 'at', 'by', 'who'])
        && request.resource.data.item is string && request.resource.data.item.size() <= 40
        && request.resource.data.ok is bool
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.who is string && request.resource.data.who.size() <= 80
        && request.resource.data.at is number
        && request.resource.data.by == me();
      allow delete: if owner();
    }

    // ── Marketing — the Marketing Command Center and its scheduled runs ──
    // apps/marketing/<collection>/<id>: state, ideaBank, weeks, archive, reports, numbers. Each holds { json, at, by }.
    match /apps/marketing/{col}/{id} {
      allow read: if runs() || hasPage('mkt');
      allow create, update: if (runs() || hasPage('mkt'))
        && request.resource.data.keys().hasOnly(['json', 'at', 'by'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000;
      allow delete: if hasPage('mkt');
    }
  }
}
